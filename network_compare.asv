%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%% EH nodes addition to WSN  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%% Initialize system  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

number_of_networks = 2;

%get the simulation parameters for network 1 from parameters1.m file
parameters0;

%create first network
net1 = network_init(P(1).('x'), P(1).('y'), P(1).('sink_x'), P(1).('sink_y'));

%create second network
net2 = network_init(P(1).('x'), P(1).('y'), P(1).('sink_x'), P(1).('sink_y'));

%create energy objects
en1 = energy(initial_battery, message_reception_cost, message_transmission_cost, irradiance_type_1, execution_time);
en2 = energy(initial_battery, message_reception_cost, message_transmission_cost, irradiance_type_2, execution_time);

%setup 
for i=1:number_of_sensors_1
    node1(i) = sensor_node(en1, net1, i, transmission_range); 
end

for i=1:number_of_sensors_2
    node2(i) = sensor_node(en2, net2, i, transmission_range); 
end


